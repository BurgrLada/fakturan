DATA_DIR=./data
# DATABASE_PATH=./data/fakturan.db
BETTER_AUTH_URL=http://localhost:3000
# min. 32 znaků: openssl rand -base64 32
BETTER_AUTH_SECRET=
# 32 bajtů v base64: openssl rand -base64 32
ENCRYPTION_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Sentry nebo GlitchTip; bez DSN se nic neposílá. Čtou se za běhu, obraz je stejný pro všechny instance
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# 0 až 1, výchozí 0
SENTRY_TRACES_SAMPLE_RATE=

# Adresa registru ARES; mění se jen kvůli testům nebo zrcadlu. Bez ní se použije veřejné API
# ARES_BASE_URL=https://ares.gov.cz/ekonomicke-subjekty-v-be/rest/ekonomicke-subjekty

# Adresa REST API VIES pro ověření DIČ; mění se jen kvůli testům. Bez ní se použije veřejné API EU
# VIES_BASE_URL=https://ec.europa.eu/taxation_customs/vies/rest-api

ALLOW_PRIVATE_MAIL_HOSTS=false
# Za reverzní proxy nastavte 1, jinak všichni klienti sdílejí jeden bucket rate limitu
TRUST_PROXY=false
